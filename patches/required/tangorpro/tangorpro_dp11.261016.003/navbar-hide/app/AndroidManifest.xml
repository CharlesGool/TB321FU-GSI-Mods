<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lenovo.tb321fu.navbar">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- 没有桌面图标。入口在 设置 → 系统 → 导航模式 → 三按钮导航 / 手势导航 的齿轮页底部
             (navbar-hide 模块的 Settings RRO 加的 Preference,intent 指向这里)。 -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>
    </application>
</manifest>
