<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lenovo.tb321fu.attest">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />
    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!--
          没有桌面图标。入口由设置注入到 设置 → 关于平板电脑 的"型号"下面:
          分类 ia.my_device_info(MyDeviceInfoFragment),group_key = device_detail_category(型号所在的分组),
          order 35:型号 30、EID 31 / IMEI 32(纯 Wi-Fi 平板不显示)、固件版本 42。设置只注入系统 App 的入口。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data android:name="com.android.settings.category" android:value="com.android.settings.category.ia.my_device_info" />
            <meta-data android:name="com.android.settings.group_key" android:value="device_detail_category" />
            <meta-data android:name="com.android.settings.order" android:value="35" />
            <meta-data android:name="com.android.settings.keyhint" android:value="tb321fu_attest" />
            <meta-data android:name="com.android.settings.title" android:resource="@string/tile_title" />
            <meta-data android:name="com.android.settings.summary" android:resource="@string/tile_summary" />
            <meta-data android:name="com.android.settings.summary_uri" android:value="content://com.lenovo.tb321fu.attest.summary/getSummary" />
        </activity>
        <provider
            android:name=".SummaryProvider"
            android:authorities="com.lenovo.tb321fu.attest.summary"
            android:exported="true" />
    </application>
</manifest>
