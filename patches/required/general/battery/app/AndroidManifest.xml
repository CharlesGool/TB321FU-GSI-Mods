<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lenovo.tb321fu.battery"
    android:versionCode="2"
    android:versionName="1.1">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="35" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
          No LAUNCHER category: the app is hidden from the launcher. The only way in is the tile
          that Settings injects into Settings > Battery (category ia.battery). Settings only
          injects tiles from system apps, so the tile appears once the APK is in the system image.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="tb321fu_battery_manager" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/tile_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/tile_summary" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://com.lenovo.tb321fu.battery.summary/getSummary" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_tile" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
        </activity>

        <!-- Dynamic summary for the Settings tile, e.g. "健康度 95% · 充电上限 80%". -->
        <provider
            android:name=".SummaryProvider"
            android:authorities="com.lenovo.tb321fu.battery.summary"
            android:exported="true" />
    </application>
</manifest>
