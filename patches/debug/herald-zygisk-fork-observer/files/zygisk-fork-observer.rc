# rootless Zygisk 阶段 2 的真机观察探针。exec_start(同步,照抄 tango-guard.rc 已经真机验证过的模式):
# init 等它跑完才往下走,拿到 zygote64 被 fork+exec 出来那一刻的 PC 和 ELF 入口地址做对比,10 秒拿不到自己放弃退出。
# 只观察、不改 zygote 的任何行为,不设 PTRACE_O_EXITKILL(万一崩了,内核会自动放行所有被跟踪的进程)。
service herald_zygisk_fork_observer /system/etc/herald_payload/zygisk-fork-observer
    user root
    group root
    seclabel u:r:herald:s0
    oneshot
    disabled

on post-fs-data
    exec_start herald_zygisk_fork_observer
