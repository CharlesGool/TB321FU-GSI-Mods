# TB321FU-GSI-Mods 构建输入的可选覆盖(device.conf 读取);写进 .env 或直接 export 均可。
# 默认值都相对本仓库或其平级数据目录解析,设了才覆盖。
TB321FU_DATA=   # 数据工程目录(底包/固件/工具来源)。默认取本仓库平级的 tb321fu_pixelos_15_tangorpro_ap3a.241005.015
GSI_SIGNER=     # AVB 签名密钥目录(含 pem/testkey_*.pem,均为公开 AOSP testkey)。默认 $TB321FU_DATA/signer
BASE_GSI=       # GSI 底包镜像路径。默认取数据目录内对应的 MysticGSI 镜像
STOCK_DIR=      # 9008 抽出的原厂 super 切片目录。默认 /tmp/9008_super_extract/carved
