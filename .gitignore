# 构建产物和临时
/out/
/build/
*.img
*.log
/devices/*/out/

# 私有件(不进仓库,见各模块 README 的"输入")
/private/
# herald 引擎二进制和 keybox 是私有的:只收脚本/sepolicy/文档,不收 payload
/mods/herald-backend/payload/

# 救回来的大文件(临时放着,整理完删)
/_rescue/

# 编译中间物
*.class
*.dex
__pycache__/
*.pyc
.claude/settings.local.json

# 本地文件与机密(all-in-one 规范)
.local/
.env

# 含专有 Megvii SDK 的预编译 APK:由 parts/002.app/src + fetch_upstream.sh 重建,不入公开仓库。
# faceunlock 现为按底包门控补丁(optional/ 与 required/tangorpro/<底包>/ 下都可能有),用 ** 覆盖所有位置。
patches/**/faceunlock/parts/002.app/files/FaceUnlock.apk
# 设置入口 overlay 内含人脸教育页素材(Google 的 Pixel 设置资源,经 ParanoidSense 上游提供),不随仓库分发;
# 由 parts/003.settings-entry/src/build.sh 从上游素材重建。旧位置的素材也继续忽略。
patches/**/faceunlock/parts/003.settings-entry/files/FaceUnlockSettingsOverlay.apk
patches/**/faceunlock/parts/003.settings-entry/src/overlay/res/raw/
# fetch_upstream.sh 拉下来的上游和自动生成的签名密钥
patches/**/faceunlock/parts/*/src/third_party/
*.keystore
# 内置功能 App 的签名 key(以后升级必须用同一把,但不进公开仓库)和编译输出
*.jks
patches/**/app/keystore/
patches/**/app/out/
